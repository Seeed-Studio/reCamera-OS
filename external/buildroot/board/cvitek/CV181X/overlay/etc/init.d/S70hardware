#!/bin/sh
${CVI_SHOPTS}
#
# Start firmware
#

export SYSTEMPATH=/mnt/system

# sensor power
function sensor_power()
{
  if [ "$(cat /proc/device-tree/model)" = "Seeed reCamera" ]; then
    GPIO_SENSOR_PWR=358
  else
    GPIO_SENSOR_PWR=495
  fi
  if [ ! -d /sys/class/gpio/gpio$GPIO_SENSOR_PWR ]; then
    echo $GPIO_SENSOR_PWR > /sys/class/gpio/export
    echo "out" > /sys/class/gpio/gpio$GPIO_SENSOR_PWR/direction
  fi

  if [ -f /sys/class/gpio/gpio$GPIO_SENSOR_PWR/value ]; then
    echo $1 > /sys/class/gpio/gpio$GPIO_SENSOR_PWR/value
  fi
}

function setup_wlan1()
{
  if [ -z "$(ifconfig wlan0 2>/dev/null)" ]; then
    return
  fi

  if [ -z "$(ifconfig wlan1 2> /dev/null)" ]; then
    iw dev wlan0 interface add wlan1 type __ap;
  fi
}

function config_ip()
{
  local iface=$1
  local ip=$2
  if [ ! -z "$(ifconfig $iface 2> /dev/null)" ]; then
    ifconfig $iface $ip
    ifconfig $iface up
  fi
}

case "$1" in
  start)
    echo "init mpp system..."
    sensor_power 1
    if [ -d $SYSTEMPATH/ko ]; then
      sh $SYSTEMPATH/ko/loadsystemko.sh
    fi

    if [ -f $SYSTEMPATH/usb-net.sh ]; then
      . $SYSTEMPATH/usb-net.sh
    fi

    sleep 0.5

    setup_wlan1
    config_ip wlan1 192.168.16.1
    config_ip usb0 192.168.42.1
  ;;

  stop)
    sensor_power 0
  ;;

  restart|reload)
  ;;

  *)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
esac

exit $?
