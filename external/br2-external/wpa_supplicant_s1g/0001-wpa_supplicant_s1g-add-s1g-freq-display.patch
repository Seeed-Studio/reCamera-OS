+/* S1G frequency display support */
+#ifndef WLAN_EID_S1G_OPERATION
+#define WLAN_EID_S1G_OPERATION 232
+#endif
+
+#ifndef WLAN_EID_SUPPORTED_OPERATING_CLASSES
+#define WLAN_EID_SUPPORTED_OPERATING_CLASSES 124
+#endif
+
+struct s1g_map {
+	int ch5g;          /* 5GHz channel (frequency in MHz) */
+	int freq_s1g;      /* S1G frequency in MHz */
+	int bw;            /* Bandwidth: 1, 2, 4, or 8 MHz */
+	int ch;            /* S1G channel number */
+	int has_off;       /* Channel offset flag (for driver bug workaround) */
+};
+
+/* US S1G channel mapping table (1-11) */
+static const struct s1g_map s1g_us[] = {
