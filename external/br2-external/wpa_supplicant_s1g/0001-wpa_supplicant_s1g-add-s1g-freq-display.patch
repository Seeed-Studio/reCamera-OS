+	{36,  902, 4, 1,  0},  /* US 4MHz ch1 */
+	{44,  906, 4, 2,  0},  /* US 4MHz ch2 */
+	{52,  910, 4, 3,  0},  /* US 4MHz ch3 */
+	{36,  902, 8, 1,  0},  /* US 8MHz ch1 */
+	{52,  910, 8, 2,  0},  /* US 8MHz ch2 */
+};
+
