+
+static char halow_country[8] = "US";
+
+static int get_halow_country(void)
+{
+	FILE *fp;
+	char line[256];
+	char *value;
+
+	fp = fopen("/etc/recamera.conf/halow_country", "r");
+	if (!fp) {
+		wpa_printf(MSG_DEBUG, "S1G: Could not open /etc/recamera.conf/halow_country, defaulting to US");
+		return 0;
+	}
+
+	if (fgets(line, sizeof(line), fp)) {
+		/* Remove trailing newline */
+		line[strcspn(line, "\n")] = 0;
+		/* Remove leading/trailing whitespace */
+		value = line;
+		while (*value == ' ' || *value == '\t') value++;
+		char *end = value + strlen(value) - 1;
+		while (end > value && (*end == ' ' || *end == '\t')) {
+			*end = 0;
+			end--;
+		}
+
+		if (strlen(value) > 0 && strlen(value) < sizeof(halow_country)) {
+			strcpy(halow_country, value);
+			wpa_printf(MSG_DEBUG, "S1G: Set country to %s", halow_country);
+		}
+	}
+	fclose(fp);
+	return 0;
+}
+
+static int is_s1g_freq(int freq)
+{
+	/* S1G frequencies are in the 900MHz range (901-928MHz) */
+	return (freq >= 900 && freq <= 928);
+}
+
+static const struct s1g_map *get_s1g_info(int freq_s1g, int freq5, int *bw_out, int *ch_out)
+{
+	const struct s1g_map *table;
+	size_t table_size;
+	int i;
+
+	/* Get country-specific table */
+	if (os_strcmp(halow_country, "AU") == 0) {
+		table = s1g_au;
+		table_size = ARRAY_SIZE(s1g_au);
+	} else {
+		table = s1g_us;
+		table_size = ARRAY_SIZE(s1g_us);
+	}
+
+	/* Try exact S1G frequency match first */
+	for (i = 0; i < table_size; i++) {
+		if (table[i].freq_s1g == freq_s1g) {
+			*bw_out = table[i].bw;
+			*ch_out = table[i].ch;
+			return &table[i];
+		}
+	}
+
+	/* Try matching by 5GHz frequency (accounting for driver bug) */
+	for (i = 0; i < table_size; i++) {
+		if (table[i].ch5g == freq5) {
+			/* For US 2MHz channel 6, driver reports ch5g=36 instead of 44 */
+			if (table[i].has_off && table[i].bw == 2 && table[i].ch == 6) {
+				/* This is the buggy case, match it */
+				*bw_out = table[i].bw;
+				*ch_out = table[i].ch;
+				return &table[i];
+			}
+			/* Normal case: only match if not a special buggy entry */
+			if (!table[i].has_off) {
+				*bw_out = table[i].bw;
+				*ch_out = table[i].ch;
+				return &table[i];
+			}
+		}
+	}
+
+	return NULL;
+}
+
+static const u8 *parse_s1g_ie(const struct wpa_bss *bss, int *s1g_bw, int *s1g_ch)
+{
+	const u8 *s1g_op_ie;
+	const u8 *op_class_ie;
+
+	*s1g_bw = 0;
+	*s1g_ch = 0;
+
+	/* Try to get S1G Operation IE */
+	s1g_op_ie = wpa_bss_get_ie(bss, WLAN_EID_S1G_OPERATION);
+	if (s1g_op_ie && s1g_op_ie[1] >= 3) {
+		/* S1G Operation IE format: EID(1) + Length(1) + Primary Ch(1) + CCFS0(1) + CCFS1(1) */
+		*s1g_ch = s1g_op_ie[2];
+		/* Try to extract bandwidth from CCFS0/CCFS1 if present */
+		if (s1g_op_ie[1] >= 5) {
+			int ccfs0 = s1g_op_ie[3];
+			int ccfs1 = s1g_op_ie[4];
+			/* Estimate bandwidth based on channel separation */
+			if (ccfs1 > 0) {
+				*s1g_bw = 8; /* Assume 8MHz if multiple channels */
+			} else if (ccfs0 > 0) {
+				*s1g_bw = 4; /* Assume 4MHz if CCFS0 present */
+			} else {
+				*s1g_bw = 2; /* Assume 2MHz otherwise */
+			}
+		} else {
+			*s1g_bw = 1; /* Default to 1MHz */
+		}
+		return s1g_op_ie;
+	}
+
+	/* Try to get Supported Operating Classes IE */
+	op_class_ie = wpa_bss_get_ie(bss, WLAN_EID_SUPPORTED_OPERATING_CLASSES);
+	if (op_class_ie) {
+		/* Operating classes can indicate bandwidth */
+		*s1g_bw = 1; /* Default */
+		return op_class_ie;
+	}
+
+	return NULL;
+}
