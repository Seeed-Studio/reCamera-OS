#!/bin/sh

PINMUX="/mnt/system/usr/bin/cvi_pinmux"
DRV_NAME="mcp251xfd"
DRV_KO="/mnt/system/ko/$DRV_NAME.ko"
TMP_GIMBAL=/tmp/gimbal
mkdir -p "$TMP_GIMBAL"

# function debug() {
#     dbg_file="$TMP_GIMBAL/dbg"
#     [ ! -f "$dbg_file" ] && echo "" > "$dbg_file"
#     echo "$1" >> "$dbg_file"
# }

function int_to_hex() {
    local nbytes=$1
    local num=$2
    local hex=$(printf "%08X" "$num")
    local nchars=$((nbytes * 2))
    hex=${hex: -$nchars}
    echo "${hex:6:2}${hex:4:2}${hex:2:2}${hex:0:2}"
}

function check_bus_ready() {
    if ifconfig can0 2>/dev/null | grep -q "HWaddr"; then
        return 1
    else
        return 0
    fi
}

function bus_init() {
    check_bus_ready
    if [ $? -eq 1 ]; then
        # echo "Device can0 is already initialized!"
        return
    fi

    if [ ! -x "$PINMUX" ]; then
        echo "No found: $PINMUX!"
        exit 1
    fi

    # Configure pinmux settings
    $PINMUX -w PAD_MIPI_TXM0/XGPIOC_12
    $PINMUX -w SD0_CLK/SPI0_SCK
    $PINMUX -w SD0_CMD/SPI0_SDO
    $PINMUX -w SD0_D0/SPI0_SDI
    #$PINMUX -w SD0_D3/SPI0_CS_X
    $PINMUX -w SD0_D3/XGPIOA_12

    # Load the kernel module
    if [ -f $DRV_KO ]; then
        insmod $DRV_KO
    fi

    # Check if the bus is ready again
    check_bus_ready
    if [ $? -eq 1 ]; then
        echo "Init can0 ok!"
    else
        echo "Init can0 failed!"
        exit 1
    fi

    ip link set can0 type can bitrate 1000000
    ifconfig can0 up
}

function bus_deinit() {
    check_bus_ready
    if [ $? -eq 1 ]; then
        ifconfig can0 down
    fi

    if ! lsmod | grep -q $DRV_NAME; then
        echo "Device can0 is not initialized!"
        return
    fi

    rmmod $DRV_KO
    echo "Uninstall can0 ok!"
}

function usage() {
    cat <<EOF
Usage:
  gimbal <options> <id> [params]

Gimbal control cmds.
  id: 1 ~ 2, angle: -36000 ~ 36000, speed: 0 ~ 60000

Options:
  init   - Init can bus.
  deinit - Deinit can bus.
  cali   - Calibration servo1 & servo2, and write zero point.
  zero   - Set zero point.

  status <id>             - Query servo status.
  cmd <id> <cmd> "<data>" - Any other cmds.
    example:
      gimbal cmd 1 81 "00000000000000"
      gimbal cmd 1 81 "00 00 00 00 00 00 00"
      gimbal cmd 1 81 "00.00.00.00.00.00.00"

  angle <id>                 - Query servo angle.
  angle <id> <angle> [speed] - Set servo angle, angle: 0 ~ 36000, default speed=100
  rel <id> <angle> [speed]   - Set relative angle, angle: -36000 ~ 36000, default speed=100


EOF
    exit 1
}

function send_frame() {
    local id=$1
    local cmd=$2
    local data=$3

    local tmp_file="$TMP_GIMBAL/ack${id}"
    local attempts=0
    local hex=""

    while [ -z "$hex" ] && [ $attempts -lt 5 ]; do
        attempts=$((attempts + 1))
        candump can0 > "$tmp_file" & pid=$!
        sleep 0.005
        cansend can0 14$id#$cmd$data
        sleep 0.005
        kill -9 $pid

        if [ ! -s "$tmp_file" ]; then
            break;
        fi

        ack_line=$(grep 14${id} "$tmp_file" | sed -n '2p')
        hex=$(echo "$ack_line" | awk '{for(i=4;i<=NF;i++) printf "%s", $i}')
        if [ "$(echo "$hex" | tr -d ' ')" = "$cmd$data" ]; then
            ack_line=$(grep 14${id} "$tmp_file" | sed -n '1p')
            hex=$(echo "$ack_line" | awk '{for(i=4;i<=NF;i++) printf "%s", $i}')
        fi
        ack_cmd=${hex:0:2}
        if [ "$ack_cmd" != "$cmd" ]; then
            hex=""
        fi
    done

    if [ ! -t 1 ]; then
        echo "$hex"
    fi

    return 1
}

function close() {
    send_frame $1 "80" "00000000000000"
}

function run() {
    send_frame $1 "88" "00000000000000"
}

function stop() {
    send_frame $1 "81" "00000000000000"
}

function set_zero() {
    local id=$1

    echo "WARNING: Executing 0x19 affects servo(id=$id) lifespan!!!"
    send_frame $id "19" "00000000000000"
}

function angle_limit() {
    local angle=$1
    local max=$(cat "$TMP_GIMBAL/max${id}" 2>/dev/null)

    if [ -n "$max" ] && [ "$max" -gt 300 ]; then
        max=$((max - 300))
        if [ "$angle" -gt "$max" ]; then
            angle=$max
        fi
    fi

    if [ "$angle" -lt 300 ]; then
        angle=300
    fi

    echo $angle
}

function set_angle() {
    local id=$1
    local angle=$2
    local speed=$3
    local direction=0

    if [ -z $speed ] || [ $speed -eq 0 ]; then
        speed=100
    fi

    angle=$(angle_limit $angle)
    current_angle=$(get_angle $id 1)
    if [ "$angle" -lt "$current_angle" ]; then
        direction=1
    fi

    local dir=$(int_to_hex 1 $direction)
    local spd=$(int_to_hex 2 $speed)
    local agl=$(int_to_hex 4 $angle)

    send_frame $id "A6" "$dir$spd$agl"
}

function set_angle_rel() { # relatively
    local id=$1
    local angle=$2
    local speed=$3

    if [ -z $speed ] || [ $speed -eq 0 ]; then
        speed=100
    fi

    send_frame $id "A8" "00$(int_to_hex 2 $speed)$(int_to_hex 4 $angle)"
}

function get_angle() { # angle
    local id=$1
    local limit=$2
    local hex=$(send_frame $id "94" "00000000000000")

    angle_str=${hex:14:2}${hex:12:2}${hex:10:2}${hex:8:2}
    angle=$((16#${angle_str}))
    if [ -n "$limit" ] && [ "$angle" -gt 35600 ]; then
        angle=0
    fi
    echo "$angle"
}

function get_current() { # current
    local id=$1
    local hex=$(send_frame $id "9C" "00000000000000")

    curr_str=${hex:6:2}${hex:4:2}
    curr=$((16#${curr_str}))
    if [ "$curr" -gt 32768 ]; then
        curr=$((0x10000 - curr))
    fi
    curr=$((curr * 33 * 1000 / 2048))
    echo "$curr"
}

function check_angle() {
    local id=$1
    local last=72000
    local attempts=0
    while [ $attempts -lt 15 ]; do
        attempts=$((attempts + 1))
        angle=$(get_angle $id)
        diff=$((angle - last))
        if [ "$diff" -ge -100 ] && [ "$diff" -le 100 ]; then
            break
        fi
        last=$angle
        sleep 0.1
    done
}

function check_zero() {
    local id=$1
    angle=$(get_angle $id 1)
    if [ "$angle" -gt 500 ]; then
        set_zero $id
        return 1
    fi
    return 0
}

function calibration() {
    local id=$1

    # seek min
    close $id
    run $id
    set_angle_rel $id -36000
    sleep 0.01
    check_angle $id
    check_zero $id

    # seek max
    close $id
    run $id
    set_angle_rel $id 36000
    sleep 0.01
    check_angle $id
    echo "$angle" > "$TMP_GIMBAL/max${id}"

    close $id
    run $id
    set_angle $id $((angle/2))
}

function check_id() {
    local id=$1
    if [ -z "$id" ] || [ "$id" -lt 1 ] || [ "$id" -gt 2 ]; then
        usage
    fi
}

if [ "$1" != "init" ] && [ "$1" != "deinit" ]; then
    check_bus_ready; ret=$?
    if [ $ret -eq 0 ]; then
        echo "Warning: Can bus is not ready."
        exit 1
    fi
fi

case $1 in
    init)
        bus_init
        # Create tmp files
        mkdir -p $TMP_GIMBAL
        echo "" > $TMP_GIMBAL/dbg
        echo "" > $TMP_GIMBAL/ack1
        echo "" > $TMP_GIMBAL/ack2
        echo "" > $TMP_GIMBAL/max1
        echo "" > $TMP_GIMBAL/max2
        chown -R recamera:recamera $TMP_GIMBAL
        ;;

    deinit)
        bus_deinit
        ;;

    cali)
        calibration 1
        calibration 2
        ;;

    close)
        id=$2
        check_id $id
        close $id
        ;;

    run)
        id=$2
        check_id $id
        run $id
        ;;
    
    stop)
        id=$2
        check_id $id
        stop $id
        ;;

    status)
        id=$2
        check_id $id
        echo "$(get_current $id)"
        ;;

    abs|angle)
        id=$2
        angle=$3
        speed=$4
        check_id $id

        # query
        if [ -z "$angle" ]; then
            echo "$(get_angle $id)"
            return
        fi

        # set
        if [ "$angle" -lt 0 ] || [ "$angle" -gt 36000 ]; then
            usage
        fi
        speed=$((speed))
        if [ "$speed" -lt 0 ] || [ "$speed" -gt 60000 ]; then
            usage
        fi

        set_angle $id $angle $speed
        ;;

    rel)
        id=$2
        angle=$3
        speed=$4
        check_id $id

        if [ -z $angle ] || [ "$angle" -lt -36000 ] || [ "$angle" -gt 36000 ]; then
            usage
        fi
        speed=$((speed))
        if [ "$speed" -lt 0 ] || [ "$speed" -gt 60000 ]; then
            usage
        fi

        current_angle=$(get_angle $id 1)
        angle=$((current_angle+angle))
        angle=$(angle_limit $angle)

        set_angle $id $angle $speed
        ;;

    zero)
        id=$2
        check_id $id
        set_zero $2
        ;;

    cmd)
        id=$2
        cmd=$3
        data=$4
        check_id $id
        if [ -z $cmd ] || [ -z $data ]; then
            usage
        fi

        echo "$(send_frame $id $cmd $(echo "$data" | tr -cd '0-9a-fA-F'))"
        ;;

    *)
        usage
        ;;
esac
