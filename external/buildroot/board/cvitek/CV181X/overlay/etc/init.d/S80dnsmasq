#!/bin/sh

CONF_FILE="/etc/dnsmasq.conf"
if [ "$(cat /sys/devices/platform/4340000.usb/udc/4340000.usb/state)" = "configured" ]; then
	CONF_FILE="/etc/dnsmasq_usb.conf"
fi

[ -f $CONF_FILE ] || exit 0

case "$1" in
	start)
		printf "Starting dnsmasq: "
		start-stop-daemon -S -x /usr/sbin/dnsmasq -- -C $CONF_FILE
		[ $? = 0 ] && echo "OK" || echo "FAIL"
		;;
	stop)
		printf "Stopping dnsmasq: "
		start-stop-daemon -K -q -x /usr/sbin/dnsmasq
		[ $? = 0 ] && echo "OK" || echo "FAIL"
		;;
	restart|reload)
		$0 stop
		$0 start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
esac

exit 0
