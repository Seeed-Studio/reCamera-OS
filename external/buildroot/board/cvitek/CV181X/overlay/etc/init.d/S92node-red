#!/bin/sh

### BEGIN INIT INFO
# Provides:          node-red
# Required-Start:    $all
# Required-Stop:     $all
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Start Node-RED at boot time
# Description:       Start Node-RED service.
### END INIT INFO

# USER=recamera  # Target user to switch to when running as root
USER=$(cat /etc/passwd | grep /bin/sh | grep -v root | awk -F':' '{print $1}')

DAEMON="/usr/bin/node-red-pi"
DAEMON_OPTS="--max-old-space-size=64 --expose-gc"
NAME=node-red
DESC="Node-RED service"

TMP_DIR="/tmp/$NAME"
PIDFILE="$TMP_DIR/pid"
[ ! -d "$TMP_DIR" ] && mkdir -p "$TMP_DIR" && chown -R $USER:$USER "$TMP_DIR"

start() {
    if [ -f $PIDFILE ]; then
        pid=$(cat $PIDFILE)

        if [ -d /proc/$pid ]; then
            if [[ "$(cat /proc/$pid/comm)" = "node-red" || "$(cat /proc/$pid/comm)" = "node" ]]; then
                echo "$DESC: $NAME($pid) is already running."
                exit 0
            fi
        fi

        pid="`pidof node-red`"
        if [[ "$pid" ]]; then
            echo "$pid" > $PIDFILE
            echo "$DESC: $NAME($pid) is already running."
            exit 0
        fi
        rm -f $PIDFILE
    fi

    # userDir must be appended BEFORE cmd is built, otherwise it never
    # reaches the daemon (cmd string snapshots DAEMON_OPTS at this point)
    if [ $(id -u) -eq 0 ]; then
        if id "$USER" &>/dev/null; then
            DAEMON_USER=$USER
            DAEMON_OPTS="$DAEMON_OPTS --userDir /home/$DAEMON_USER/.node-red"
        fi
    else
        DAEMON_USER=$(whoami)
        DAEMON_OPTS="$DAEMON_OPTS --userDir /home/$DAEMON_USER/.node-red"
    fi

    local cmd="start-stop-daemon -S -q -m -b -p $PIDFILE --exec $DAEMON -- $DAEMON_OPTS"
    echo "Starting $DESC: $NAME"
    if [ $(id -u) -eq 0 ]; then
        if [ -n "$DAEMON_USER" ]; then
            echo "Switching to user: $DAEMON_USER"
        else
            DAEMON_USER=root
        fi
        su $DAEMON_USER -c "$cmd"
    else
        $cmd
    fi
    [ $? = 0 ] && echo "OK" || echo "FAIL"
}

stop() {
    echo "Stopping $DESC: $NAME"
    if [ -f $PIDFILE ]; then
        start-stop-daemon -K -q -p $PIDFILE
        # wait for the process to exit so a following start() does not race
        # the dying process for the port (EADDRINUSE) or the pidfile
        pid=$(cat $PIDFILE 2>/dev/null)
        i=0
        while [ -n "$pid" ] && [ -d /proc/$pid ] && [ $i -lt 50 ]; do
            sleep 0.2
            i=$((i+1))
        done
        [ -n "$pid" ] && [ -d /proc/$pid ] && kill -9 $pid 2>/dev/null
        rm -f $PIDFILE
    fi
    [ $? = 0 ] && echo "OK" || echo "FAIL"
}

restart() {
    stop
    start
}

status() {
    if [ -f $PIDFILE ]; then
        pid=$(cat $PIDFILE)
        if [ -d /proc/$pid ] && { [ "$(cat /proc/$pid/comm 2>/dev/null)" = "node-red" ] || [ "$(cat /proc/$pid/comm 2>/dev/null)" = "node" ]; }; then
            echo "$NAME (pid $pid) is running."
        else
            echo "$NAME (pid $pid) is NOT running (stale pidfile)."
        fi
    else
        pid="`pidof node-red`"
        if [ -n "$pid" ]; then
            echo "$NAME (pid $pid) is running."
        else
            echo "$NAME is not running."
        fi
    fi
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart)
        restart
        ;;
    status)
        status
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac

exit 0
