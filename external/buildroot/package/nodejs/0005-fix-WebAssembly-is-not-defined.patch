From: mingzq <north_sea@qq.com>
Date: Fri, 25 Oct 2024 02:25:24 +0000
Subject: [PATCH 1/1] fix: WebAssembly is not defined

---
 deps/undici/src/lib/dispatcher/client.js | 2 +-
 deps/undici/undici.js                    | 4 ++--
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/deps/undici/src/lib/dispatcher/client.js b/deps/undici/src/lib/dispatcher/client.js
index cb61206b..e314031e 100644
--- a/deps/undici/src/lib/dispatcher/client.js
+++ b/deps/undici/src/lib/dispatcher/client.js
@@ -57,7 +57,7 @@ const {
   kMaxConcurrentStreams,
   kResume
 } = require('../core/symbols.js')
-const connectH1 = require('./client-h1.js')
+const connectH1 = require('./client-h2.js')
 const connectH2 = require('./client-h2.js')
 let deprecatedInterceptorWarned = false
 
diff --git a/deps/undici/undici.js b/deps/undici/undici.js
index acbece91..416e1874 100644
--- a/deps/undici/undici.js
+++ b/deps/undici/undici.js
@@ -5512,7 +5512,7 @@ Content-Type: ${value.type || "application/octet-stream"}\r
 
 // lib/dispatcher/client-h1.js
 var require_client_h1 = __commonJS({
-  "lib/dispatcher/client-h1.js"(exports2, module2) {
+  "lib/dispatcher/client-h2.js"(exports2, module2) {
     "use strict";
     var assert = require("node:assert");
     var util = require_util();
@@ -7306,7 +7306,7 @@ var require_client = __commonJS({
       kMaxConcurrentStreams,
       kResume
     } = require_symbols();
-    var connectH1 = require_client_h1();
+    var connectH1 = require_client_h2();
     var connectH2 = require_client_h2();
     var deprecatedInterceptorWarned = false;
     var kClosedResolve = Symbol("kClosedResolve");
