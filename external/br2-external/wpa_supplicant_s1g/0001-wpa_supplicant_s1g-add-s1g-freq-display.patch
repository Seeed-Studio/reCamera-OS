 /* Format one result on one text line into a buffer. */
 static int wpa_supplicant_ctrl_iface_scan_result(
 	struct wpa_supplicant *wpa_s,
@@ -3035,6 +3234,8 @@ static int wpa_supplicant_ctrl_iface_scan_result(
 	char *pos, *end;
 	int ret;
 	const u8 *ie, *ie2, *osen_ie, *p2p, *mesh, *owe, *rsnxe;
+	int s1g_bw = 0, s1g_ch = 0;
+	const struct s1g_map *s1g_info = NULL;
 
 	mesh = wpa_bss_get_ie(bss, WLAN_EID_MESH_ID);
 	p2p = wpa_bss_get_vendor_ie(bss, P2P_IE_VENDOR_TYPE);
@@ -3048,11 +3249,62 @@ static int wpa_supplicant_ctrl_iface_scan_result(
 	pos = buf;
 	end = buf + buflen;
 
-	ret = os_snprintf(pos, end - pos, MACSTR "\t%d\t%d\t",
-			  MAC2STR(bss->bssid), bss->freq, bss->level);
-	if (os_snprintf_error(end - pos, ret))
-		return -1;
-	pos += ret;
+	/* Check if this is an S1G network and get country info */
+	get_halow_country();
+
+	/* For S1G networks, use custom output format */
+	if (is_s1g_freq(bss->freq)) {
+		/* Parse S1G IEs to get bandwidth and channel info */
+		parse_s1g_ie(bss, &s1g_bw, &s1g_ch);
+
+		/* Look up S1G mapping info based on S1G frequency and 5GHz center freq */
+		/* Try to derive 5GHz center freq from the bss data if available */
+		int freq5 = bss->freq; /* This might be 5GHz center freq in some cases */
+
+		/* If we have S1G IEs, try to match in our table */
+		if (s1g_ch > 0 || s1g_bw > 0) {
+			/* Try to find matching entry */
+			s1g_info = get_s1g_info(bss->freq, freq5, &s1g_bw, &s1g_ch);
+		} else {
+			/* No IE info, try frequency-based lookup */
+			s1g_info = get_s1g_info(bss->freq, freq5, &s1g_bw, &s1g_ch);
+		}
+
+		/* Format: bssid freq_s1g.0 bw_M ch freq_5g level flags ssid */
+		ret = os_snprintf(pos, end - pos, MACSTR "\t%d.0\t%dM\t%d\t",
+				  MAC2STR(bss->bssid), bss->freq, s1g_bw, s1g_ch);
+		if (os_snprintf_error(end - pos, ret))
+			return -1;
+		pos += ret;
+
+		/* Add 5GHz frequency if available from mapping */
+		if (s1g_info) {
+			ret = os_snprintf(pos, end - pos, "%d\t",
+					s1g_info->ch5g);
+			if (os_snprintf_error(end - pos, ret))
+				return -1;
+			pos += ret;
+		} else {
+			/* No 5GHz freq available, put 0 */
+			ret = os_snprintf(pos, end - pos, "0\t");
+			if (os_snprintf_error(end - pos, ret))
+				return -1;
+			pos += ret;
+		}
+
+		/* Add signal level */
+		ret = os_snprintf(pos, end - pos, "%d\t", bss->level);
+		if (os_snprintf_error(end - pos, ret))
+			return -1;
+		pos += ret;
+	} else {
+		/* Standard 2.4/5GHz network output */
+		ret = os_snprintf(pos, end - pos, MACSTR "\t%d\t%d\t",
+				  MAC2STR(bss->bssid), bss->freq, bss->level);
+		if (os_snprintf_error(end - pos, ret))
+			return -1;
+		pos += ret;
+	}
 	ie = wpa_bss_get_vendor_ie(bss, WPA_IE_VENDOR_TYPE);
 	if (ie)
 		pos = wpa_supplicant_ie_txt(pos, end, "WPA", ie, 2 + ie[1]);
