+	{40,  904, 1, 3,  0},  /* US 1MHz ch3 */
+	{40,  905, 1, 4,  0},  /* US 1MHz ch4 */
+	{44,  906, 1, 5,  0},  /* US 1MHz ch5 */
+	{36,  903, 2, 6,  1},  /* US 2MHz ch6 - driver bug workaround */
+	{44,  907, 1, 6,  0},  /* US 1MHz ch6 */
+	{48,  908, 1, 7,  0},  /* US 1MHz ch7 */
+	{52,  909, 1, 8,  0},  /* US 1MHz ch8 */
+	{56,  910, 1, 9,  0},  /* US 1MHz ch9 */
+	{60,  911, 1, 10, 0},  /* US 1MHz ch10 */
+	{64,  912, 1, 11, 0},  /* US 1MHz ch11 */
